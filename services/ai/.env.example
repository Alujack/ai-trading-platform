# AI analysis service — copy to services/ai/.env and fill in the key(s) you have.
# The service always boots on the built-in "mock" provider; a provider only
# becomes selectable in the dashboard toggle once its key is set here.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google (Gemini) ---  key format: AIza...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Provider selected on startup: "auto" (prefer a configured real provider,
# else mock), or one of: mock | anthropic | gemini
DEFAULT_PROVIDER=auto
