# Copy to .env (in this services/mt5bridge folder) on the Windows host. Never commit.

# --- Exness account (DEMO first!) ---
# From the MT5 terminal: File > Login to Trade Account shows your login + server.
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
# Demo server is usually "Exness-MT5Trial" (or "Exness-MT5Trial7" etc.) —
# use the EXACT name shown in the terminal. Real is "Exness-MT5Real…".
MT5_SERVER=Exness-MT5Trial
# Optional: full path to terminal64.exe if auto-detect fails, e.g.
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe
MT5_TERMINAL_PATH=

# --- Bridge HTTP server ---
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8800
# Shared secret the main API sends as the X-Bridge-Token header. Generate a long
# random string (PowerShell: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')).
MT5_BRIDGE_TOKEN=replace-with-a-long-random-secret

# Default max slippage in points if the order request omits one.
DEFAULT_DEVIATION=20
