generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Impact {
  LOW
  MEDIUM
  HIGH
}

enum Direction {
  LONG
  SHORT
}

enum SignalStatus {
  PENDING
  ACTIVE
  CLOSED
  CANCELLED
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum ExecutionMode {
  OFF // kill-switch: signals are generated + logged, never executed
  AUTO // open immediately after AI+risk approval (today's behavior)
  CONFIRM // require a Telegram Approve before opening
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// Verdict the layer stack returned for a raw strategy proposal.
enum RawVerdict {
  PENDING // recorded, gate still running
  GENERATED // cleared every layer -> became a real Signal
  REJECTED // a layer refused it (AI score/judgment, risk, regime)
  SKIPPED // never evaluated (duplicate, cooldown, thin data, AI down)
}

model Candle {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String
  open      Decimal  @db.Decimal(18, 8)
  high      Decimal  @db.Decimal(18, 8)
  low       Decimal  @db.Decimal(18, 8)
  close     Decimal  @db.Decimal(18, 8)
  volume    Decimal  @db.Decimal(24, 8)
  timestamp DateTime
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp])
}

model Indicator {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String
  timestamp DateTime
  rsi       Decimal? @db.Decimal(10, 4)
  ema20     Decimal? @db.Decimal(18, 8)
  ema50     Decimal? @db.Decimal(18, 8)
  ema200    Decimal? @db.Decimal(18, 8)
  atr       Decimal? @db.Decimal(18, 8)
  bbLower   Decimal? @db.Decimal(18, 8)
  bbUpper   Decimal? @db.Decimal(18, 8)
  bbPctB    Decimal? @db.Decimal(18, 8)
  adx       Decimal? @db.Decimal(18, 8)
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp])
}

model NewsEvent {
  id          String   @id @default(cuid())
  title       String
  impact      Impact
  currency    String
  scheduledAt DateTime
  actual      String?
  forecast    String?
  previous    String?
  aiSummary   String?
  createdAt   DateTime @default(now())

  @@unique([title, scheduledAt])
  @@index([scheduledAt])
  @@index([currency])
}

model Strategy {
  id        String   @id @default(cuid())
  name      String   @unique // "trend_ema", "meanrev_rsi", "breakout_donchian", "carry"
  enabled   Boolean  @default(false)
  regimes   String // CSV of allowed regimes, e.g. "TRENDING" / "RANGING,VOLATILE"
  params    Json // strategy-specific parameters (thresholds, ATR multipliers, …)
  createdAt DateTime @default(now())
}

model Signal {
  id              String       @id @default(cuid())
  symbol          String
  timeframe       String
  direction       Direction
  entryPrice      Decimal      @db.Decimal(18, 8)
  stopLoss        Decimal      @db.Decimal(18, 8)
  takeProfit      Decimal      @db.Decimal(18, 8)
  confidenceScore Int
  aiReasoning     String
  strategyName    String?
  status          SignalStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  trades          Trade[]
  approval        Approval?

  @@index([symbol, status])
  @@index([strategyName])
  @@index([createdAt])
}

model Trade {
  id              String      @id @default(cuid())
  signalId        String
  signal          Signal      @relation(fields: [signalId], references: [id])
  entryPrice      Decimal     @db.Decimal(18, 8)
  exitPrice       Decimal?    @db.Decimal(18, 8)
  positionSize    Decimal     @db.Decimal(24, 8)
  riskAmount      Decimal     @db.Decimal(18, 2)
  profitLoss      Decimal?    @db.Decimal(18, 2)
  status          TradeStatus @default(OPEN)
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  // Live broker fields (Plan 08, Phase 4): set when BROKER=exness
  externalOrderId String?     // MT5 ticket number
  brokerFillPrice Decimal?    @db.Decimal(18, 8) // actual fill price from broker
  broker          String?     // "paper" | "exness_demo" | "exness_real"
  journals        Journal[]

  @@index([signalId])
  @@index([status])
  @@index([externalOrderId])
}

model Journal {
  id        String   @id @default(cuid())
  tradeId   String
  trade     Trade    @relation(fields: [tradeId], references: [id])
  notes     String
  aiReview  String
  emotions  String?
  // Per-trade learning loop: filled on close by /analyze/trade-review. `grade`
  // scores the PROCESS (A–F), not the P&L; `rMultiple` (net P&L ÷ risk) feeds
  // expectancy tracking; `lesson` is the one actionable takeaway.
  grade     String? // "A" | "B" | "C" | "D" | "F"
  outcome   String? // "WIN" | "LOSS" | "BREAKEVEN"
  lesson    String?
  rMultiple Decimal? @db.Decimal(12, 4)
  createdAt DateTime @default(now())

  @@index([tradeId])
}

model RiskLog {
  id                    String   @id @default(cuid())
  accountBalance        Decimal  @db.Decimal(18, 2)
  riskPercent           Decimal  @db.Decimal(6, 4)
  positionSize          Decimal  @db.Decimal(24, 8)
  dailyLoss             Decimal  @db.Decimal(18, 2)
  dailyLossLimit        Decimal  @db.Decimal(18, 2)
  circuitBreakerTripped Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@index([createdAt])
}

// Runtime-controllable risk parameters, resolved most-specific-wins
// (SYMBOL ► STRATEGY ► GLOBAL). Override rows set only the fields they change;
// nulls fall through to the next scope, then to code defaults (config/defaults.ts).
model RiskConfig {
  id                    String   @id @default(cuid())
  scope                 String // "GLOBAL" | "STRATEGY" | "SYMBOL"
  scopeKey              String // ""(global) | strategyName | symbol
  riskPerTradePct       Decimal? @db.Decimal(7, 4)
  minRR                 Decimal? @db.Decimal(7, 4)
  dailyLossLimitPct     Decimal? @db.Decimal(7, 4)
  dailyProfitTargetPct  Decimal? @db.Decimal(7, 4)
  maxDrawdownPct        Decimal? @db.Decimal(7, 4)
  maxOpenTrades         Int?
  maxTradesPerDay       Int?
  maxOpenRiskPct        Decimal? @db.Decimal(7, 4)
  maxRiskPerCurrencyPct Decimal? @db.Decimal(7, 4)
  newsBeforeMin         Int?
  newsAfterMin          Int?
  aiMinScore            Int?
  approvalTtlMin        Int?
  enabled               Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  @@unique([scope, scopeKey])
}

// Per-scope OFF/AUTO/CONFIRM execution behaviour.
model ExecutionSetting {
  id        String        @id @default(cuid())
  scope     String // "GLOBAL" | "STRATEGY" | "SYMBOL"
  scopeKey  String
  mode      ExecutionMode @default(CONFIRM)
  updatedAt DateTime      @updatedAt

  @@unique([scope, scopeKey])
}

// Who-changed-what audit trail for every config/mode write.
model ConfigAudit {
  id        String   @id @default(cuid())
  actor     String // "ui:yan" | "telegram:<id>" | "system"
  entity    String // "RiskConfig" | "ExecutionSetting"
  scope     String
  scopeKey  String
  before    Json
  after     Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A single backtest run: the config it was run with, the per-(strategy,symbol,
// timeframe) result metrics, and the equity curve for each, so the dashboard can
// render results without re-running anything. Written by services/data/backtester.py
// (--save-db); read by the web app via GET /api/backtests.
model BacktestRun {
  id              String   @id @default(cuid())
  label           String?
  startingBalance Decimal  @db.Decimal(18, 2)
  riskPct         Decimal  @db.Decimal(7, 4)
  costsApplied    Boolean  @default(true)
  config          Json // { timeframes, symbols, spread/slippage/commission overrides }
  results         Json // array of metric objects (one per strategy×symbol×timeframe) + verdict
  equityCurves    Json? // { "strategy|symbol|timeframe": [[isoTimestamp, equity], ...] }
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

// Broker (MT5) account credentials, set from the web UI instead of .env so the
// product is configurable without touching files. The password is stored
// ENCRYPTED at rest (AES-256-GCM, see lib/crypto.ts) and never returned to the
// client. Single-account v1: one row is `isActive`; the broker pushes it to the
// MT5 bridge via POST /session/login. Multi-tenant is a later effort.
model BrokerCredential {
  id          String   @id @default(cuid())
  broker      String   @default("exness") // broker family; only "exness"/MT5 today
  login       Int // MT5 account number
  passwordEnc String // encrypted blob "iv:authTag:ciphertext" (hex), never plaintext
  server      String // MT5 server name, e.g. "Exness-MT5Trial7"
  env         String   @default("demo") // "demo" | "real" — mirrors ExnessBroker.env
  isActive    Boolean  @default(true)
  lastTest    Json? // { ok: boolean, detail: string, testedAt: ISO } from /session/login
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// A config change proposed by an analysis agent (e.g. the weekly journal
// review). This row IS the journal of the recommendation: agents never edit
// production config — a human approves via Telegram, and only then is the
// change applied (with a ConfigAudit entry).
model AgentRecommendation {
  id            String         @id @default(cuid())
  agent         String // "weekly_review"
  entity        String // "RiskConfig" | "ExecutionSetting" | "Strategy"
  scope         String // "GLOBAL" | "STRATEGY" | "SYMBOL"
  scopeKey      String // ""(global) | strategyName | symbol
  field         String // e.g. "riskPerTradePct" | "mode" | "timeframes"
  currentValue  Json
  proposedValue Json
  rationale     String
  status        ApprovalStatus @default(PENDING)
  chatId        String?
  messageId     String? // Telegram message id (for editMessageText)
  decidedBy     String? // Telegram user id/name who acted
  decidedAt     DateTime?
  appliedAt     DateTime? // set when the approved change was written to config
  expiresAt     DateTime
  createdAt     DateTime       @default(now())

  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

// Human-in-the-loop approval for CONFIRM-mode signals.
model Approval {
  id        String         @id @default(cuid())
  signalId  String         @unique
  signal    Signal         @relation(fields: [signalId], references: [id])
  status    ApprovalStatus @default(PENDING)
  chatId    String
  messageId String? // Telegram message id (for editMessageText)
  decidedBy String? // Telegram user id/name who acted
  decidedAt DateTime?
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([status])
  @@index([expiresAt])
}

// The PURE strategy feed: every candidate a strategy emits, recorded BEFORE any
// protection layer runs, then stamped with what the layers said about it. This is
// the "layers off" view for manual trading — the operator sees the untouched
// strategy proposal plus a badge for whichever layer would have stopped it.
//
// SAFETY: this table is intentionally an island. It has NO relation to Trade or
// Approval, and nothing in execution/ ever reads it, so a raw row can never
// become a position — the CLAUDE.md rule "risk engine before any trade
// execution" still holds for every path that can move money. Only rows that
// cleared the whole stack carry a `signalId`, and it is the Signal (not this
// row) that execution acts on.
//
// Written only while the `raw_signal_feed` FeatureFlag is on; off = zero rows,
// zero overhead.
model RawSignal {
  id           String     @id @default(cuid())
  symbol       String
  timeframe    String
  direction    Direction
  entryPrice   Decimal    @db.Decimal(18, 8)
  stopLoss     Decimal    @db.Decimal(18, 8)
  takeProfit   Decimal    @db.Decimal(18, 8)
  // The strategy's OWN confidence, pre-AI. Never overwritten by an AI score.
  confidence   Int
  // The strategy's own rationale, verbatim.
  reasoning    String
  strategyName String
  verdict      RawVerdict @default(PENDING)
  // Machine tag of the FIRST layer that stopped it: "ai_score" | "ai_judgment" |
  // "ai_unreachable" | "risk_news" | "risk_rr" | "risk_daily_loss" |
  // "risk_drawdown" | "risk" | "regime" | "cooldown" | "duplicate" |
  // "insufficient_candles". Null when it passed everything.
  blockedBy     String?
  // Full human-readable reason from the gate/risk engine.
  blockedReason String?
  // Set only when the candidate cleared every layer and a Signal was persisted.
  signalId      String?
  // Collapses re-emissions of the same proposal (clientId, or a per-day hash of
  // the levels) so a 1-min scan loop can't flood the feed.
  dedupeKey  String   @unique
  seenCount  Int      @default(1)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([strategyName])
  @@index([symbol, timeframe])
  @@index([verdict])
}

// Generic on/off switches the dashboard can flip at runtime. Today: the
// `raw_signal_feed` toggle. Absent row = the env default (see config/flags.ts).
// Every write lands in ConfigAudit like any other config change.
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
