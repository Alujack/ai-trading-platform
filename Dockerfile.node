# syntax=docker/dockerfile:1
# Dev image for the Next.js workspace (apps/web).
#
# Since plan 11 Phase 8 removed the Express API, this image serves one service.
# It no longer installs the Python backtester deps (the Python backend spawns
# that itself) and no longer generates a Prisma client (Alembic + SQLAlchemy own
# persistence now). Source is bind-mounted at runtime for hot reload, so the
# image only needs the dependency tree.
FROM node:20-bookworm-slim

WORKDIR /app

# Copy only manifests first for better layer caching. Workspace symlinks resolve
# against these (the package.json files), so npm install can wire the monorepo
# before the source is present.
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN npm install

# Now the source (bind mounts override the live-edited subtrees at runtime).
COPY . .
