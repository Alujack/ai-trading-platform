# syntax=docker/dockerfile:1
# Shared dev image for the Node workspaces (apps/api + apps/web).
# Installs the whole monorepo's deps once; each service picks its own CMD in
# docker-compose. Source is bind-mounted at runtime for hot reload, so this
# image only needs the dependency tree + a generated Prisma client baked in.
FROM node:20-bookworm-slim

# Prisma's query engine needs openssl at runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only manifests first for better layer caching. Workspace symlinks resolve
# against these (the package.json files), so npm install can wire the monorepo
# before the source is present.
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN npm install

# Now the source (bind mounts override the live-edited subtrees at runtime).
COPY . .

# Generate the Prisma client into node_modules (no DB connection needed here;
# `migrate deploy` against the running Postgres happens in the api service CMD).
RUN npx prisma generate --schema=apps/api/prisma/schema.prisma
