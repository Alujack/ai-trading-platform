# ---------------------------------------------------------------------------
# Copy to .env (and per-app .env.local where applicable). Never commit secrets.
# ---------------------------------------------------------------------------

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL / TimescaleDB ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- API service (apps/api) ----
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# ---- Web app (apps/web) ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- AI service (services/ai) ----
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# ---- Data service (services/data) ----
DATA_WORKER_CONCURRENCY=4

# ---- Auth / sessions ----
JWT_SECRET=replace-me-with-a-long-random-string
SESSION_SECRET=replace-me-with-a-long-random-string

# ---- Secret encryption (broker credentials at rest) ----
# Required to save MT5 credentials from the web UI. 32 bytes as 64 hex chars.
# Generate: openssl rand -hex 32   — MUST stay stable or saved secrets become
# undecryptable after a restart.
ENCRYPTION_KEY=

# ---- LLM providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Market data providers ----
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
IEX_API_KEY=
TIINGO_API_KEY=

# ---- News / sentiment providers ----
NEWSAPI_KEY=

# ---- n8n (news-automation layer) ----
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
# Required to start n8n. Generate once: openssl rand -hex 24
N8N_ENCRYPTION_KEY=
# URL n8n workflows POST to for AI news summaries (the AI service, respecting
# the Mock/Claude/Gemini toggle). From inside Compose use the service name.
NEWS_SUMMARY_URL=http://localhost:8000/analyze/news-summary

# ---- Paper trading / execution control ----
# Today's behaviour is AUTO; the control layer defaults new scopes to CONFIRM.
ENABLE_PAPER_TRADING=true
ENABLE_WEEKLY_REVIEW=false
PAPER_ACCOUNT_BALANCE=10000
PAPER_PEAK_BALANCE=10000
PAPER_RISK_PERCENT=1
PAPER_MAX_OPEN_TRADES=5

# ---- Telegram confirm-to-trade bridge ----
# From @BotFather. Leave blank to disable Telegram (CONFIRM signals still log).
TELEGRAM_BOT_TOKEN=
# Chat the alerts are sent to (your user id or a group id).
TELEGRAM_CHAT_ID=
# Random string set when registering the webhook; verified on every callback.
# Generate once: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user ids allowed to approve/command (allowlist).
TELEGRAM_ALLOWED_USER_IDS=

# ---- Broker selection (Plan 08) ----
# paper  → PaperBroker (simulation, default — safe for development)
# exness → ExnessBroker via MT5 bridge (requires MT5_BRIDGE_URL + MT5_BRIDGE_TOKEN)
BROKER=paper
# demo | real — labels the live broker; "real" requires the promotion gate (see docs/plans/08).
EXNESS_ENV=demo

# ---- MT5 bridge (Windows host — only needed when BROKER=exness) ----
# URL of the FastAPI bridge running on the Windows machine beside the MT5 terminal.
# Same machine as Docker:  http://host.docker.internal:8800
# Different machine/VPS:   http://<windows-host-ip>:8800
MT5_BRIDGE_URL=http://host.docker.internal:8800
# Shared secret sent as X-Bridge-Token header. Must match the bridge's .env.
# Generate: powershell -Command "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
MT5_BRIDGE_TOKEN=
# Override symbol names if your Exness account type uses suffixed names (e.g. EURUSDm).
# Leave blank to use defaults (EURUSD, XAUUSD, BTCUSD).
# BROKER_SYMBOL_MAP={"EURUSD":"EURUSDm","XAUUSD":"XAUUSDm","BTCUSD":"BTCUSDm"}

# ---- Strategy runner (data worker) ----
# Which symbols/timeframes the runner evaluates strategies on. The scalp_vwap
# scalper needs a low timeframe — include 1min (and/or 5min).
# STRATEGY_SYMBOLS=XAUUSD,EURUSD,BTCUSD
# STRATEGY_TIMEFRAMES=1min,5min,15min,60min
# Regime gating (default on): scalp_vwap declares regimes=TRENDING, so it is skipped
# in RANGING (chop) and VOLATILE (news) automatically. Set false to disable gating.
# STRATEGY_REGIME_GATING=true

# ---- Fast scalp manager (Phase 3 — active 15s position management) ----
# Opt-in, live-only: runs the two-check-adverse / unsafe-stop / profit-lock exits
# every 15s on open scalp* trades. Leave false until a green backtest + paper run.
ENABLE_SCALP_MANAGER=false
# Only manage trades whose strategyName starts with this prefix.
# SCALP_MANAGED_PREFIX=scalp
# Exit thresholds in R (unrealized P&L ÷ trade risk). Defaults shown.
# SCALP_MIN_STOP_RATIO=0.5    # close if the fill ate >half the intended stop room
# SCALP_EMERGENCY_R=0.8       # one-check emergency close at R <= -0.8
# SCALP_WATCH_R=0.5           # two-check adverse engages at R <= -0.5
# SCALP_TRAIL_START_R=1.0     # profit-lock arms once R reaches +1.0
# SCALP_TRAIL_GIVEBACK_R=0.5  # ...then close if it gives back 0.5R
