# ---------------------------------------------------------------------------
# Copy to .env (and per-app .env.local where applicable). Never commit secrets.
# ---------------------------------------------------------------------------

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL / TimescaleDB ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Python backend (services/backend) ----
# The trading-domain API: signal gate, risk engine, execution, AI, Telegram +
# broker integrations, realtime and the scheduled jobs. See docs/plans/11.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Exactly ONE process may own the scheduled jobs (approval expiry, paper
# reconcile, scalp management, daily briefing). Set false on every additional
# replica, or two runtimes will double-execute a tick.
BACKEND_JOB_OWNER=true

# Shadow mode: compute and REPORT every decision, write nothing. Used to validate
# decision parity before ownership changes hands. A shadow instance never inserts
# a signal, opens a trade, writes a RiskLog, messages Telegram or contacts MT5,
# and its schedulers stay stopped.
API_SHADOW_MODE=false

# Redis key held during the execution-owner handover so two engines can't both
# start. See docs/runbooks/11-cutover-and-rollback.md.
API_MIGRATION_LOCK_KEY=migration:execution-owner

# ---- Web app (apps/web) ----
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only BFF target. The browser calls same-origin /api/* on Next.js, which
# forwards here. NOT NEXT_PUBLIC_: the backend hostname must never reach the
# client bundle. In Compose this is http://backend:8000.
PYTHON_API_URL=http://localhost:8000
# How long a proxied (non-streaming) request may take before the BFF returns 504.
# PYTHON_API_TIMEOUT_MS=30000

# ---- Worker → backend ----
# Base URL the Python worker uses for its API calls (candidate submission,
# rt-notify, the raw-feed probe). Compose sets it to http://backend:8000.
API_PUBLIC_URL=http://localhost:8000

# The browser does not need a backend URL. Leave BLANK so apps/web uses relative
# /api paths through its own BFF; set it only to point the dashboard at a backend
# running outside Next.
NEXT_PUBLIC_API_URL=

# ---- AI analysis ----
# services/ai has been REMOVED; its code lives in
# services/backend/app/integrations/ai and the /analyze/* routes are served by
# the backend itself. This URL is only for external callers (n8n workflows) and
# the legacy Express container.
AI_SERVICE_URL=http://localhost:8000

# ---- Data service (services/data) ----
DATA_WORKER_CONCURRENCY=4

# ---- Auth / sessions ----
JWT_SECRET=replace-me-with-a-long-random-string
SESSION_SECRET=replace-me-with-a-long-random-string

# ---- Secret encryption (broker credentials at rest) ----
# Required to save MT5 credentials from the web UI. 32 bytes as 64 hex chars.
# Generate: openssl rand -hex 32   — MUST stay stable or saved secrets become
# undecryptable after a restart.
ENCRYPTION_KEY=

# ---- LLM providers ----
# Read by services/backend/app/integrations/ai. These used to live in a
# service-local services/ai/.env; they belong in the ROOT .env now, or the
# backend silently falls back to the built-in `mock` provider.
#
# The gate fails CLOSED on a bad key: an unreachable or rejecting provider means
# candidates are SKIPPED, never approved. Check `GET /api/ai-provider` and
# `POST /api/ai-provider/test` after changing a key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-opus-5
# auto = pick a configured real provider, else mock. Or pin: mock|anthropic|gemini
DEFAULT_PROVIDER=auto

# ---- Market data providers ----
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
IEX_API_KEY=
TIINGO_API_KEY=

# ---- News / sentiment providers ----
NEWSAPI_KEY=

# ---- n8n (news-automation layer) ----
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
# Required to start n8n. Generate once: openssl rand -hex 24
N8N_ENCRYPTION_KEY=
# URL n8n workflows POST to for AI news summaries — now the Python backend's
# /analyze/* compatibility route, still respecting the Mock/Claude/Gemini toggle.
# From inside Compose use the service name: http://backend:8000/...
NEWS_SUMMARY_URL=http://localhost:8000/analyze/news-summary

# ---- Paper trading / execution control ----
# Today's behaviour is AUTO; the control layer defaults new scopes to CONFIRM.
ENABLE_PAPER_TRADING=true
ENABLE_WEEKLY_REVIEW=false
PAPER_ACCOUNT_BALANCE=10000
PAPER_PEAK_BALANCE=10000
PAPER_RISK_PERCENT=1
# NOTE: when UNSET this var has two different fallbacks, both preserved from the
# original implementation — the risk-engine concurrency cap falls back to 1 (the
# "one trade at a time" sticky rule) while the dashboard's `maxOpen` display
# falls back to 5. Setting it explicitly applies to both. A malformed value now
# fails at boot instead of silently disabling the cap.
PAPER_MAX_OPEN_TRADES=5

# ---- Telegram confirm-to-trade bridge ----
# From @BotFather. Leave blank to disable Telegram (CONFIRM signals still log).
TELEGRAM_BOT_TOKEN=
# Chat the alerts are sent to (your user id or a group id).
TELEGRAM_CHAT_ID=
# Random string set when registering the webhook; verified on every callback.
# Generate once: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user ids allowed to approve/command (allowlist).
TELEGRAM_ALLOWED_USER_IDS=

# ---- Broker selection (Plan 08) ----
# paper  → PaperBroker (simulation, default — safe for development)
# exness → ExnessBroker via MT5 bridge (requires MT5_BRIDGE_URL + MT5_BRIDGE_TOKEN)
BROKER=paper
# demo | real — labels the live broker; "real" requires the promotion gate (see docs/plans/08).
EXNESS_ENV=demo

# ---- MT5 bridge (Windows host — only needed when BROKER=exness) ----
# URL of the FastAPI bridge running on the Windows machine beside the MT5 terminal.
# Same machine as Docker:  http://host.docker.internal:8800
# Different machine/VPS:   http://<windows-host-ip>:8800
MT5_BRIDGE_URL=http://host.docker.internal:8800
# Shared secret sent as X-Bridge-Token header. Must match the bridge's .env.
# Generate: powershell -Command "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
MT5_BRIDGE_TOKEN=
# Override symbol names if your Exness account type uses suffixed names (e.g. EURUSDm).
# Leave blank to use defaults (EURUSD, XAUUSD, BTCUSD). Also used by the data
# worker when CANDLE_SOURCE=mt5 so data and orders agree on the broker symbol.
# BROKER_SYMBOL_MAP={"EURUSD":"EURUSDm","XAUUSD":"XAUUSDm","BTCUSD":"BTCUSDm"}
# Ingest candles from the MT5 bridge (broker-accurate, UTC, no rate limits)
# instead of TwelveData; falls back to TwelveData if the bridge is down.
# CANDLE_SOURCE=mt5

# ---- Strategy runner (data worker) ----
# The single switch the cutover/rollback flips: where candidates are submitted.
# FastAPI backend:  http://backend:8000/api/signals/candidate   (current)
# Legacy Express:   http://api:4000/api/signals/candidate       (rollback)
# STRATEGY_GATE_URL=http://backend:8000/api/signals/candidate
# Base URL for the worker's other API calls (rt-notify, raw-feed probe).
# WORKER_API_BASE=http://backend:8000
# Which symbols/timeframes the runner evaluates strategies on. The scalp_vwap
# scalper needs a low timeframe — include 1min (and/or 5min).
# STRATEGY_SYMBOLS=XAUUSD,EURUSD,BTCUSD
# STRATEGY_TIMEFRAMES=1min,5min,15min,60min
# How often the runner scans (default 900s). Scans only read the DB and POST to
# the gate, so a faster cadence costs no provider quota — but it is pointless
# unless ingestion keeps up: a scan can only see bars the ingest loop fetched.
# STRATEGY_PERIOD_SECONDS=120
# Regime gating (default on): scalp_vwap declares regimes=TRENDING, so it is skipped
# in RANGING (chop) and VOLATILE (news) automatically. Set false to disable gating.
# STRATEGY_REGIME_GATING=true

# ---- Ingest scope and cadence ----
# Which symbols the CANDLE loop fetches (default: all of XAUUSD,EURUSD,BTCUSD).
# Provider cost is per symbol, so narrowing this is what pays for a faster
# low-timeframe cadence. Symbols left out simply stop updating — their stored
# candles freeze, and the runner's freshness guard then refuses to trade them.
# INGEST_SYMBOLS=XAUUSD
# 5min fetch period (default 900s). The runner's freshness guard allows 600s and
# worst-case bar age is period + 300s, so 900s can never pass it and 300s sits
# exactly on the limit: use 240s if you want the runner to see 5min bars at all.
# 1min is NOT tunable here — 60s ingestion is only viable on CANDLE_SOURCE=mt5,
# which has no per-request provider limit (see services/data/main.py).
# INGEST_PERIOD_5MIN_S=240

# ---- Gate layers (switchable) ----
# The filters between "a strategy saw a setup" and "a signal exists". Each is
# switchable so the desk can run pure strategy output:
#   AI_VALIDATION     the model scores the setup and may veto it
#   REGIME_GATING     strategies only run in the regimes they declare
#   KILLZONE_GATING   setups only inside the London / NY-AM windows
#   BIAS_FILTER       the EMA bias vetoes counter-trend directions
#   DISCOUNT_FILTER   longs only in discount, shorts only in premium
# Unlike every other flag here these DEFAULT ON, and a flag-store outage leaves
# them on — a check can only be removed deliberately.
# NOT switchable, by design (CLAUDE.md): the risk engine (position sizing,
# stop/RR validation, news blackout), the daily-loss and drawdown breakers, the
# portfolio caps, and the data-freshness guard. "Strategy only" means no opinion
# is applied to the setup, not that trades stop being sized and bounded.
# These env vars are only DEFAULTS: the dashboard control (Risk page → Execution
# Control → Gate layers) and PUT /api/config/layers are stored in the DB and
# always win. `{"mode":"STRATEGY_ONLY"}` clears all five at once; `{"mode":"FULL"}`
# restores them; `{"layer":"killzone_gating","enabled":false}` flips just one.
# AI_VALIDATION=true
# REGIME_GATING=true
# KILLZONE_GATING=true
# BIAS_FILTER=true
# DISCOUNT_FILTER=true

# ---- Raw strategy feed ("layers off" view) ----
# Shows every candidate a strategy emits — untouched, with the layer that stopped
# it NAMED instead of applied — so you can trade the pure strategy signal by hand
# while automation keeps running the full protected stack. Observe-only: raw rows
# live in their own table with no path to a trade, and this never relaxes a check
# on the execution path.
# This env var is only the DEFAULT: the dashboard toggle (Signals page, or
# PUT /api/config/raw-feed) is stored in the DB and always wins.
# The data worker also probes GET /api/config/raw-feed each scan, so the toggle
# also decides whether candidates the worker-side guards refused — regime gating
# and data freshness — are posted for visibility.
# WARNING: with the feed on, NO layer is hidden, freshness included. Candidates
# from a frozen series are tagged "STALE DATA" with the bar age, because their
# entry/SL/TP may be nowhere near the live market. Re-check the price before
# acting on one by hand. They still cannot execute: the gate refuses every
# pre-gated candidate without running AI/risk, so none becomes a Signal.
# RAW_SIGNAL_FEED=false

# ---- Fast scalp manager (Phase 3 — active 15s position management) ----
# Opt-in, live-only: runs the two-check-adverse / unsafe-stop / profit-lock exits
# every 15s on open scalp* trades. Leave false until a green backtest + paper run.
ENABLE_SCALP_MANAGER=false
# Only manage trades whose strategyName starts with this prefix.
# SCALP_MANAGED_PREFIX=scalp
# Exit thresholds in R (unrealized P&L ÷ trade risk). Defaults shown.
# SCALP_MIN_STOP_RATIO=0.5    # close if the fill ate >half the intended stop room
# SCALP_EMERGENCY_R=0.8       # one-check emergency close at R <= -0.8
# SCALP_WATCH_R=0.5           # two-check adverse engages at R <= -0.5
# SCALP_TRAIL_START_R=1.0     # profit-lock arms once R reaches +1.0
# SCALP_TRAIL_GIVEBACK_R=0.5  # ...then close if it gives back 0.5R
