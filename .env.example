# ---------------------------------------------------------------------------
# Copy to .env (and per-app .env.local where applicable). Never commit secrets.
# ---------------------------------------------------------------------------

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL / TimescaleDB ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- API service (apps/api) ----
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# ---- Web app (apps/web) ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- AI service (services/ai) ----
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# ---- Data service (services/data) ----
DATA_WORKER_CONCURRENCY=4

# ---- Auth / sessions ----
JWT_SECRET=replace-me-with-a-long-random-string
SESSION_SECRET=replace-me-with-a-long-random-string

# ---- LLM providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Market data providers ----
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
IEX_API_KEY=
TIINGO_API_KEY=

# ---- News / sentiment providers ----
NEWSAPI_KEY=
